# Copy to .env before running `docker compose up`.
DATABASE_NAME=vaultvid
DATABASE_PASSWORD=change-me

OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me-too

# Address the browser uses to fetch thumbnails. Presigned URLs are signed against this host, so
# it has to be reachable from outside the compose network.
OBJECT_STORAGE_PUBLIC_ENDPOINT=localhost:9000

RABBITMQ_USER=vaultvid
RABBITMQ_PASSWORD=change-me-as-well
