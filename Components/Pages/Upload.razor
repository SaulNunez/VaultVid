@page "/upload"
@using AspNetCoreGeneratedDocument
@using VideoHostingService.Models
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject VideoHostingService.Services.IVideoService VideoService

<PageTitle>Upload</PageTitle>

<h1>Upload</h1>

<EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Title:</label>
        <InputText @bind-Value="formModel.Title" class="form-control" />
    </div>

    <div>
        <label>Description:</label>
        <InputText type="textarea" @bind-Value="formModel.Description" class="form-control" />
    </div>

    <div>
        <img @ref="previewImageElem" style="max-width:200px;max-height:200px" />
        <label>Thumbnail:</label>
        <InputFile @ref="inputFile" OnChange="UploadThumbnail" />
    </div>

    <div>
        <label>Video:</label>
        <InputFile OnChange="UploadVideo" />
        @if (isUploadingVideo)
        {
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width:@string.Format("{0:P0}", progressPercent);"
                    aria-valuenow="@string.Format("{0:P0}", progressPercent)" aria-valuemin="0" aria-valuemax="100">
                    @string.Format("{0:P0}", progressPercent)
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    private VideoUpload formModel = new();
    private InputFile? inputFile;
    private ElementReference previewImageElem;
    private int progressPercent;

    private bool isUploadingVideo = false;

    private async Task ShowPreview() => await JS.InvokeVoidAsync(
    "previewImage", inputFile!.Element, previewImageElem);

    private void UploadThumbnail(InputFileChangeEventArgs e){
        ShowPreview();

        var contentType = imageFile.ContentType;
        var uploadedFileName = imageFile.Name;
        var fileSize = imageFile.Size;

        string ext = Path.GetExtension(uploadedFileName).ToLowerInvariant();

        var stream = e.File.OpenReadStream(maxFileSize);
        var tokenSource = new CancellationTokenSource();
        var location = await VideoService.UploadThumbnail(stream, fileSize, ext, contentType, tokenSource.Token);
    }

    private void UpdateVideoUploadProgress(ProgressReport currentProgress) {
        progressPercent = currentProgress.Percentage();
        StateHasChanged();
    }

    private async Task UploadVideo(InputFileChangeEventArgs e)
    {
        var contentType = e.File.ContentType;
        var fileSize = e.File.Size;

        string ext = Path.GetExtension(uploadedFileName).ToLowerInvariant();

        var progress = new Progress<ProgressReport>(UpdateVideoUploadProgress);
        var stream = e.File.OpenReadStream(maxFileSize);
        var tokenSource = new CancellationTokenSource();
        var location = await VideoService.UploadVideo(stream, fileSize, ext, contentType, progress, tokenSource.Token);
    }

    private async Task HandleValidSubmit(CancellationToken token)
    {
        await VideoService.AddVideo(formModel, token);
    }
}
