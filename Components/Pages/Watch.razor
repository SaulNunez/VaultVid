@page "/video/{PublicId:guid}"
@implements IAsyncDisposable

@inject IVideoService VideoService
@inject IMediaUrlService MediaUrls
@inject IJSRuntime JS
@inject ILogger<Watch> Logger

<PageTitle>@(video?.Title ?? "Video")</PageTitle>

@if (loadFailed)
{
    <p role="alert">Something went wrong loading this video.</p>
}
else if (!loaded)
{
    <p aria-live="polite">Loading&hellip;</p>
}
else if (video is null)
{
    <h1>Video not found</h1>
    <p>This video doesn't exist, or it was removed.</p>
}
else
{
    <h1 class="video_item_title">@video.Title</h1>

    <div @ref="playerContainer"></div>

    <div>
        <p>@video.Description</p>
    </div>

    <h2>Comments</h2>

    <AuthorizeView>
        <Authorized>
            <CommentCreation VideoPublicId="PublicId" OnCommentAdded="OnCommentAdded" />
        </Authorized>
        <NotAuthorized>
            <p><a href="Identity/Account/Login">Log in</a> to leave a comment.</p>
        </NotAuthorized>
    </AuthorizeView>

    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (var comment in comments)
        {
            <Comment VideoComment="comment" @key="comment.Id" />
        }
    }
}

@code {
    private const int CommentPageSize = 50;

    [Parameter]
    public Guid PublicId { get; set; }

    [Inject]
    private IVideoCommentService CommentService { get; set; } = default!;

    private VideoHostingService.Models.Video? video;
    private List<VideoComment> comments = [];
    private bool loaded;
    private bool loadFailed;

    private ElementReference playerContainer;
    private IJSObjectReference? playerModule;
    private IJSObjectReference? player;
    private string? videoUrl;
    private string? posterUrl;
    private readonly CancellationTokenSource pageCts = new();

    // The route parameter can change without the component being recreated, so load in
    // OnParametersSetAsync rather than OnInitializedAsync.
    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        loadFailed = false;

        try
        {
            video = await VideoService.GetByPublicIdAsync(PublicId, pageCts.Token);

            if (video is not null)
            {
                videoUrl = await MediaUrls.GetUrlAsync(video.ObjectName, pageCts.Token);
                posterUrl = await MediaUrls.GetUrlAsync(video.ThumbnailLocation, pageCts.Token);
                comments = [.. await CommentService.GetCommentsAsync(PublicId, CommentPageSize, 0, pageCts.Token)];
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-load; nothing to show.
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Could not load video {PublicId}", PublicId);
            loadFailed = true;
        }
        finally
        {
            loaded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (player is not null || videoUrl is null || !loaded)
        {
            return;
        }

        try
        {
            playerModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Watch.razor.js");

            player = await playerModule.InvokeAsync<IJSObjectReference>(
                "createPlayer", playerContainer, videoUrl, posterUrl, video?.Title);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to clean up.
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Could not initialise the video player");
        }
    }

    private void OnCommentAdded(VideoComment comment)
    {
        comments.Insert(0, comment);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await pageCts.CancelAsync();
        pageCts.Dispose();

        try
        {
            if (player is not null)
            {
                await player.InvokeVoidAsync("destroy");
                await player.DisposeAsync();
            }

            if (playerModule is not null)
            {
                await playerModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already torn down.
        }
    }
}
