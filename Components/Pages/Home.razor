@page "/"
@inject IVideoService VideoService
@inject IMediaUrlService MediaUrls
@inject ILogger<Home> Logger

<PageTitle>VaultVid</PageTitle>

<h1>Latest videos</h1>

@if (loadFailed)
{
    <p role="alert">Something went wrong loading videos. Try again in a moment.</p>
}
else if (cards is null)
{
    <p aria-live="polite">Loading videos&hellip;</p>
}
else if (cards.Count == 0)
{
    <p>No videos have been uploaded yet.</p>
}
else
{
    <div class="video_grid">
        @foreach (var card in cards)
        {
            <a class="video_big_card" href="video/@card.PublicId" @key="card.PublicId">
                @if (card.ThumbnailUrl is null)
                {
                    <div class="video_big_card_thumbnail video_big_card_thumbnail--empty" aria-hidden="true"></div>
                }
                else
                {
                    <img class="video_big_card_thumbnail" src="@card.ThumbnailUrl" alt="" loading="lazy" />
                }
                <p class="video_big_card_title">@card.Title</p>
                @if (!card.IsReady)
                {
                    <p class="video_big_card_badge">Processing</p>
                }
            </a>
        }
    </div>
}

@code {
    private const int PageSize = 50;

    private List<VideoCard>? cards;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var videos = await VideoService.GetRecentAsync(PageSize, CancellationToken.None);

            cards = [];
            foreach (var video in videos)
            {
                // Presigning is a local signature computation, not a call to the storage server.
                var thumbnailUrl = await MediaUrls.GetUrlAsync(video.ThumbnailLocation);
                cards.Add(new VideoCard(
                    video.PublicId,
                    video.Title,
                    thumbnailUrl,
                    video.Status == VideoStatus.Ready));
            }
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Could not load the video list");
            loadFailed = true;
        }
    }

    private sealed record VideoCard(Guid PublicId, string Title, string? ThumbnailUrl, bool IsReady);
}
