@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @* Keeps a failure in one page from tearing down the whole circuit. *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <h1>Something went wrong</h1>
                    <p>This page couldn't be shown. The error has been logged.</p>
                    <button class="btn btn-primary" @onclick="Recover">Try again</button>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // A boundary latches after it catches; navigating to a new page should clear it.
    protected override void OnParametersSet() => errorBoundary?.Recover();

    private void Recover() => errorBoundary?.Recover();
}
