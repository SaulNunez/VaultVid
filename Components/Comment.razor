@inject IHumanTimeService HumanTimeService

<div class="video_comment">
    <p class="video_comment_title">
        @VideoComment.UserName
        <span aria-hidden="true">-</span>
        <time datetime="@VideoComment.CreatedAt.ToString("o")">
            @HumanTimeService.PrettyTimeDifference(VideoComment.CreatedAt, DateTimeOffset.UtcNow)
        </time>
    </p>
    <p class="video_comment_comment">@VideoComment.Text</p>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public VideoComment VideoComment { get; set; } = default!;
}
