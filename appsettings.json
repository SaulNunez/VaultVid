{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MaxUploadSizes": {
    "MaxVideoSize": 2147483648,
    "MaxThumbnailSize": 10485760
  },
  "Identity": {
    "RequireConfirmedAccount": true
  },
  "ObjectStorage": {
    "BucketName": "vaultvid",
    "UseSsl": false,
    "PresignedUrlExpirySeconds": 3600
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/",
    "QueueName": "vaultvid.transcode"
  },
  "TranscodeSweeper": {
    "SweepIntervalSeconds": 120,
    "StuckAfterMinutes": 30,
    "PendingGraceMinutes": 10,
    "BatchSize": 25
  }
}
